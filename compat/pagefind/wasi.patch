+#[cfg(target_os = "wasi")]
+mod wasi_io {
+    use super::*;
+
+    pub fn flush(rx: &mut mpsc::UnboundedReceiver<ServiceResponse>) {
+        let mut stdout = std::io::stdout().lock();
+        while let Ok(msg) = rx.try_recv() {
+            let encoded = general_purpose::STANDARD.encode(serde_json::to_vec(&msg).unwrap());
+            stdout.write_all(encoded.as_bytes()).unwrap();
+            stdout.write(b",").unwrap();
+        }
+        stdout.flush().unwrap();
+    }
+
+    /// One request from stdin; None after reporting a bad message. Exits at EOF.
+    pub fn read(err_tx: &mpsc::UnboundedSender<ServiceResponse>) -> Option<ServiceRequest> {
+        let mut buf = vec![];
+        std::io::stdin().lock().read_until(b',', &mut buf).unwrap();
+        if buf.pop().is_none() {
+            std::process::exit(0);
+        }
+        let report = |payload| {
+            let _ = err_tx.send(ServiceResponse { message_id: None, payload });
+        };
+        let Ok(decoded) = general_purpose::STANDARD.decode(buf) else {
+            report(ResponseAction::Error { original_message: None, message: "Unparseable message, not valid base64".into() });
+            return None;
+        };
+        match serde_json::from_slice::<ServiceRequest>(&decoded) {
+            Ok(msg) => Some(msg),
+            Err(e) => {
+                report(match std::str::from_utf8(&decoded[..]) {
+                    Ok(msg) => ResponseAction::Error { original_message: Some(msg.to_string()), message: format!("{e}") },
+                    Err(_) => ResponseAction::Error {
+                        original_message: None,
+                        message: "Pagefind was unable to parse the message it was provided via the service".to_string(),
+                    },
+                });
+                None
+            }
+        }
+    }
+}
--- a/src/wasi_fs.rs
+++ b/src/wasi_fs.rs
@@ -0,0 +1,18 @@
+//! tokio::fs is not available on wasm: the same calls over std::fs.
+use std::io::Write;
+use std::path::Path;
+
+pub async fn create_dir_all(p: impl AsRef<Path>) -> std::io::Result<()> {
+    std::fs::create_dir_all(p)
+}
+
+pub struct File(std::fs::File);
+
+impl File {
+    pub async fn create(p: impl AsRef<Path>) -> std::io::Result<File> {
+        std::fs::File::create(p).map(File)
+    }
+    pub async fn write_all(&mut self, buf: &[u8]) -> std::io::Result<()> {
+        self.0.write_all(buf)
+    }
+}
