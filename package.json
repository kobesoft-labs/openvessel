{
  "name": "openvessel",
  "version": "1.0.0",
  "description": "A browser-only Node.js-like environment for building and previewing Astro sites. Clean-room, no real ports.",
  "homepage": "https://github.com/kobesoft-labs/openvessel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kobesoft-labs/openvessel.git"
  },
  "bugs": {
    "url": "https://github.com/kobesoft-labs/openvessel/issues"
  },
  "keywords": [
    "nodejs",
    "browser",
    "webassembly",
    "astro",
    "sandbox",
    "playground"
  ],
  "openvessel": {
    "node": "22.23.4"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/host/index.js",
  "types": "./dist/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/host/index.d.ts",
      "default": "./dist/host/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch & node scripts/serve.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit -p .",
    "build:types": "node scripts/build-types.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "amaro": "1.1.8",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "buffer": "^6.0.3",
    "cjs-module-lexer": "^2.3.0",
    "es-module-lexer": "^3.0.4",
    "fflate": "^0.8.3",
    "pako": "^3.0.2",
    "readable-stream": "^4.8.0",
    "sucrase": "^3.35.1"
  }
}
